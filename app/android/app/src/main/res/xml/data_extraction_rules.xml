<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for Google cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="sapna-data.tmp.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="sapna-data.tmp.json" />
    </device-transfer>
</data-extraction-rules>
